{
    "name": "elkuku/maxfielder",
    "description": "A maxfield frontend",
    "type": "project",
    "license": "WTFPL",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3",
        "easycorp/easyadmin-bundle": "^5.0",
        "elkuku/kuku-sf-system-tools-bundle": "^1.0",
        "elkuku/maxfield-bundle": "dev-master",
        "elkuku/maxfield-parser": "dev-master",
        "elkuku/symfony-utils": "dev-master",
        "google/apiclient": "^2.13",
        "knpuniversity/oauth2-client-bundle": "^2.3",
        "league/oauth2-github": "^3.0",
        "league/oauth2-google": "^5.0",
        "liip/imagine-bundle": "^2.3",
        "pagerfanta/pagerfanta": "^4.2",
        "pagerfanta/twig": "^4.2",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "8.*",
        "symfony/asset-mapper": "8.*",
        "symfony/console": "8.*",
        "symfony/dotenv": "8.*",
        "symfony/expression-language": "8.*",
        "symfony/flex": "^2.11",
        "symfony/form": "8.*",
        "symfony/framework-bundle": "8.*",
        "symfony/http-client": "8.*",
        "symfony/intl": "8.*",
        "symfony/mailer": "8.*",
        "symfony/mime": "8.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "8.*",
        "symfony/process": "8.*",
        "symfony/property-access": "8.*",
        "symfony/property-info": "8.*",
        "symfony/runtime": "8.*",
        "symfony/security-bundle": "8.*",
        "symfony/serializer": "8.*",
        "symfony/stimulus-bundle": "^3",
        "symfony/string": "8.*",
        "symfony/translation": "8.*",
        "symfony/twig-bundle": "8.*",
        "symfony/validator": "8.*",
        "symfony/web-link": "8.*",
        "symfony/yaml": "8.*",
        "twig/extra-bundle": "^3.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13",
        "rector/rector": "^2.0",
        "rector/type-perfect": "^2.0",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "8.*",
        "symfony/css-selector": "8.*",
        "symfony/debug-bundle": "8.*",
        "symfony/maker-bundle": "^1.0",
        "symfony/phpunit-bridge": "8.*",
        "symfony/stopwatch": "8.*",
        "symfony/var-dumper": "8.*",
        "symfony/web-profiler-bundle": "8.*",
        "tomasvotruba/cognitive-complexity": "^1.0",
        "tomasvotruba/type-coverage": "^2.0",
        "zenstruck/foundry": "^2.9"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "translate": [
            "@translate-all"
        ],
        "translate-all": {
            "en": "./bin/console translation:extract --format=yaml --domain=messages --force en",
            "es": "./bin/console translation:extract --format=yaml --domain=messages --force es",
            "de": "./bin/console translation:extract --format=yaml --domain=messages --force de"
        },
        "test-phpunit": ["make tests"],
        "test-phpstan": ["vendor/bin/phpstan analyse --memory-limit=2G"],
        "test-phpstan-baseline": ["vendor/bin/phpstan analyse --generate-baseline --memory-limit=2G"],
        "ci": ["@test-phpunit", "@test-phpstan"],
        "coverage": ["XDEBUG_MODE=coverage php vendor/bin/phpunit --coverage-text"],
        "coverage-html": ["XDEBUG_MODE=coverage php vendor/bin/phpunit --coverage-html coverage"],
        "check" : [
            "echo 'Check for outdated assets:'",
            "bin/console importmap:outdated",
            "echo 'Check for outdated PHP deps:'",
            "composer outdated",
            "echo 'Check for outdated Recipes:'",
            "composer recipes:update"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.*"
        }
    }
}
